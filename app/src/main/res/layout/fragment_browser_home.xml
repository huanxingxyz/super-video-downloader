<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".ui.main.home.browser.homeTab.BrowserHomeFragment">

    <data>
        <import type="android.view.View" />
        <import type="com.myAllVideoBrowser.data.local.model.Suggestion" />
        <import type="com.myAllVideoBrowser.data.local.room.entity.PageInfo" />
        <import type="com.myAllVideoBrowser.ui.main.home.browser.BrowserListener" alias="Listener" />
        <import type="com.myAllVideoBrowser.ui.main.home.browser.homeTab.BrowserHomeViewModel" alias="HomeVM" />
        <import type="com.myAllVideoBrowser.ui.main.home.MainViewModel" alias="MainVM" />

        <variable
            name="browserMenuListener"
            type="Listener" />

        <variable
            name="viewModel"
            type="HomeVM" />

        <variable
            name="mainVModel"
            type="MainVM" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:orientation="vertical">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBarLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:elevation="0dp"
            android:background="@android:color/transparent"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tv_tab_count"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="16dp"
                    android:background="@drawable/tab_box_bg"
                    android:gravity="center"
                    android:onClick="@{() -> mainVModel.openNavDrawer()}"
                    android:text="@{`` + viewModel.tabCount}"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:id="@+id/iv_help"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="12dp"
                        android:src="@drawable/help_24px"
                        app:tint="#000000" />

                    <ImageView
                        android:id="@+id/iv_settings"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="12dp"
                        android:src="@drawable/settings_24px"
                        app:tint="#000000" />

                    <ImageView
                        android:id="@+id/browser_home_menu_button"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="8dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:contentDescription="Menu"
                        android:focusable="true"
                        android:onClick="@{() -> browserMenuListener.onBrowserMenuClicked()}"
                        android:padding="12dp"
                        android:src="@drawable/ic_more_gray_24dp"
                        app:tint="#000000" />
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.appbar.AppBarLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="24dp"
            android:paddingTop="16dp">

            <LinearLayout
                android:id="@+id/search_container"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/search_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintTop_toTopOf="parent">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/home_et_search"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:focusable="@{viewModel.isSearchInputFocused}"
                    android:focusableInTouchMode="@{viewModel.isSearchInputFocused}"
                    android:hint="搜索或输入网址"
                    android:onClick="@{() -> viewModel.changeSearchFocus(true)}"
                    android:paddingHorizontal="16dp"
                    android:singleLine="true"
                    android:text="@{viewModel.searchTextInput}"
                    android:textColor="#333333"
                    android:textColorHint="#999999"
                    android:textSize="14sp"
                    app:items="@{viewModel.listSuggestions}" />

                <ImageView
                    android:id="@+id/go_button"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="14dp"
                    android:src="@drawable/arrow_back24px"
                    app:tint="#999999" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <GridView
            android:id="@+id/top_pages_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:horizontalSpacing="8dp"
            android:numColumns="4"
            android:paddingHorizontal="16dp"
            android:verticalSpacing="16dp"
            app:topPages="@{mainVModel.bookmarksList}" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_download_method"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginHorizontal="32dp"
            android:layout_marginTop="32dp"
            android:backgroundTint="#1877F2"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="下载方法"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            app:cornerRadius="27dp"
            app:icon="@drawable/help_24px"
            app:iconGravity="textStart"
            app:iconTint="#FFFFFF" />

    </LinearLayout>
</layout>
